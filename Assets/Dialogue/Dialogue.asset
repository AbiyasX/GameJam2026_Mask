  m_Script: {fileID: 11500000, guid: 9a11ea4359bb2fe4daf565d6bc53ca10, type: 3}
  m_Name: Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogTextData
  lines:
  - characterName: Heredith
    text: "My dear Panacea\u2026 *cough* *cough* I fear this sickness shall soon
      claim us all\u2026"
  - characterName: Panacea
    text: "No\u2026 Mother\u2026."
  - characterName: Heredith
    text: My dear, as you are the only soul untouched by this plague, please gather
      the necessary ingredients for the Theriac.
  - characterName: Heredith
    text: "Starting from yeast from the bakery, that\u2019s located directly north
      from the well."
  - characterName: Panacea
    text: Yes, Mother. Anything for you all!
  - characterName: Heredith
    text: "Be sure to wear your father\u2019s old mask before going to town\u2026"
